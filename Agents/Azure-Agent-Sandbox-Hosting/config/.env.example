# Copy to .env at the repository root, fill in once, then load it in every shell:
#   cp config/.env.example .env && set -a && . ./.env && set +a
# .env is git-ignored. No secret belongs in this file: every tool signs in with Azure CLI.

# --- Shared ------------------------------------------------------------------
SUBSCRIPTION_ID=YOUR-SUBSCRIPTION-ID
LOCATION=eastus2
# Resource group the agenthost workshop deploys into (A, B and C share it).
RESOURCE_GROUP=rg-agenthost-workshop
# Where you clone the workshop (github.com/oxcp/ainotes, pinned to 905f2c2).
WORKSHOP_DIR=$HOME/ainotes
# Deployment suffix the workshop's module-01 writes to the resource group tag deploymentSN.
# Step 2 prints it; paste it here.
SN=YOUR-DEPLOYMENT-SUFFIX

# --- A · ACA Sandboxes (tools/aca_sandbox.py, tools/measure_aca.py) -----------
# Names follow the workshop's convention; override any of them if yours differ.
ACA_SANDBOX_GROUP=sandbox-group-agenthost-${SN}
ACA_ACR_NAME=acragenthost${SN}
ACA_IMAGE=acragenthost${SN}.azurecr.io/agent-host:latest
ACA_UAMI_NAME=id-agenthost-${SN}
# Optional client ID; leave empty to resolve it with az identity show.
ACA_UAMI_CLIENT_ID=
ACA_STORAGE_ACCOUNT=stcagenthost${SN}
ACA_STATE_CONTAINER=agent-state
# Free /24 in the VNet the sandboxes join (README step 4 creates the subnet and prints its ID).
ACA_SUBNET_PREFIX=10.225.1.0/24
# Full resource ID of that subnet, delegated to Microsoft.App/environments; paste the ID README step 4 prints.
ACA_SUBNET_ID=YOUR-ACA-SUBNET-RESOURCE-ID
ACA_VNET_CONNECTION=aca-vnet
ACA_VOLUME=agent-state-blob
ACA_APIM_ENDPOINT=https://apim-agenthost-${SN}.azure-api.net/foundry
ACA_MODEL=gpt-5.4-mini
# Optional: your public egress address in CIDR form, for the port's IP allow rule.
ACA_ALLOW_CIDR=

# --- B · Foundry hosted agent (workshop module-02) ----------------------------
# module-01 creates account foundry-agenthost-${SN} with project maf-agent-prj.
PROJECT_ID=/subscriptions/${SUBSCRIPTION_ID}/resourceGroups/${RESOURCE_GROUP}/providers/Microsoft.CognitiveServices/accounts/foundry-agenthost-${SN}/projects/maf-agent-prj
PROJECT_ENDPOINT=https://foundry-agenthost-${SN}.services.ai.azure.com/api/projects/maf-agent-prj

# --- C · AKS + agent-sandbox (workshop module-03) ------------------------------
AKS_NAME=aks-agenthost-${SN}
NAMESPACE=agent
AGENT_SANDBOX_VERSION=v0.5.2
# Required for C: your public egress CIDR allowed to reach the workshop HTTP app.
C_ALLOW_CIDR=YOUR-PUBLIC-EGRESS-CIDR

# --- D · BYO-AKS (private preview) ---------------------------------------------
# Local directory of the product-group sample, after its private settings are configured.
BYOAKS_SAMPLE_DIR=YOUR-APPROVED-SAMPLE-DIRECTORY
BYOAKS_RESOURCE_GROUP=YOUR-BYOAKS-RESOURCE-GROUP
BYOAKS_CLUSTER=YOUR-AKS-CLUSTER
BYOAKS_KATA_POOL=agentpool
BYOAKS_KATA_VM_SIZE=Standard_D4s_v5
# Resource group and name of the network security group on the AKS subnet (not the AKS-managed NIC NSG).
BYOAKS_SUBNET_NSG_RG=YOUR-VNET-RESOURCE-GROUP
BYOAKS_SUBNET_NSG=YOUR-SUBNET-NSG

# --- Measuring B or D through the Responses endpoint ---------------------------
# From `azd ai agent show`: .../agents/<agent>/endpoint/protocols/openai/responses?api-version=v1
AGENT_RESPONSES_URL=https://YOUR-ENDPOINT.services.ai.azure.com/api/projects/YOUR-PROJECT/agents/YOUR-AGENT/endpoint/protocols/openai/responses?api-version=v1
# D only: namespace that holds the session pods (kubectl get ns | grep foundry-).
SESSION_NAMESPACE=foundry-YOUR-PROJECT-HASH

# --- E · E2B on Azure VM -------------------------------------------------------
E2B_RESOURCE_GROUP=YOUR-E2B-RESOURCE-GROUP
E2B_VM_NAME=YOUR-E2B-VM-NAME
E2B_API_URL=http://YOUR-E2B-VM-HOST:3000
E2B_SANDBOX_URL=http://YOUR-E2B-VM-HOST:3002
