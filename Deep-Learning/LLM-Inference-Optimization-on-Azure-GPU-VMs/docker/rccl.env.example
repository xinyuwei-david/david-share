# Copy to docker/rccl.env on both Linux hosts. Shell assignments, no spaces
# around '='. Addresses and paths are supplied once here, not in commands.
# The hosts must already trust each other's host SSH keys.
NODE_A=
NODE_B=

# Build once and push to your registry; use the same digest on both hosts.
RCCL_IMAGE=
RCCL_CONTAINER=rccl-benchmark
RCCL_SSH_PORT=2222

# Same absolute directory on both hosts, ending in /rccl-ssh.
# Contains private SSH material; use a dedicated, private directory.
RCCL_SSH_DIR=

# Host route: use the HPC image's own MPI and RCCL test binary.
RCCL_HOST_BIN=/opt/rccl-tests/all_reduce_perf
RCCL_HOST_MODULE=mpi/hpcx

# Keep each new run in a new directory; never overwrite recorded evidence.
RCCL_OUTPUT_DIR=
