  "configuration": "custom agent disk image + VNet + OnDemand port, no Blob volume",
  "sandbox_spec": {
    "cpu": "1000m",
    "memory": "2048Mi",
    "auto_suspend_seconds": 900,
    "auto_suspend_mode": "Memory",
    "port": 8080,
    "port_activation": "OnDemand",
    "vnet_connection": true,
    "blob_volume_mount": null,
    "state_path": "/app/app/data (STATE_MOUNT_PATH as before, now on the sandbox's own disk)",
    "entrypoint": "cd /app && exec python -m app.main"
  },
  "inputs": {
    "first": "Where is Bangkok? Answer in one short sentence.",
    "warm": "How many questions have I asked before this one? Number only.",
    "first_after_resume": "How many questions have I asked before this one? Number only.",
    "warm_after_resume": "How many questions have I asked before this one? Number only.",
    "request": "POST http://127.0.0.1:8080/reflect {\"query\": <input>}, sent with sandbox exec from inside the sandbox, after 127.0.0.1:8080 accepts a connection"
  },
  "clocks": {
    "create_total_s": "SDK create call until the sandbox reads Running (polled every 0.25 s), wall time on the client",
    "ready_wait_s": "inside the sandbox, until 127.0.0.1:8080 accepted a TCP connection (checked every 0.1 s, up to 60 s), before the request",
    "guest_s": "HTTP /reflect duration measured inside the sandbox",
    "cold_total_s": "create_total_s + first.ready_wait_s + first.guest_s",
    "resume_total_s": "SDK resume call until Running",
    "recover_total_s": "resume_total_s + first_after_resume.ready_wait_s + first_after_resume.guest_s"
  },
