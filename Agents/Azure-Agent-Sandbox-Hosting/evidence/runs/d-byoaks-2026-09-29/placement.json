    {
      "source": "AzureCloud",
      "destination": "agent node :443",
      "access": "Deny",
      "rule": "defaultSecurityRules/DenyAllInBound"
    },
    {
      "source": "AzureCloud",
      "destination": "agent node :443",
      "access": "Deny",
      "rule": "defaultSecurityRules/DenyAllInBound"
    },
    {
      "source": "VNet",
      "destination": "agent node :443",
      "access": "Allow",
      "rule": "defaultSecurityRules/AllowVnetInBound"
    }
  ],
